# Copy to .env and fill in. .env is git-ignored — never commit real tokens.

# Hugging Face read token — only needed ONCE to download the gated
# pyannote/speaker-diarization-community-1 model. Not used afterwards.
HF_TOKEN=hf_your_token_here

# Optional: use a manually downloaded pipeline folder (containing config.yaml)
# TALKTIME_DIARIZATION_PATH=C:\models\speaker-diarization-community-1

# Optional: store recordings, database and reports somewhere else
# TALKTIME_DATA_DIR=D:\TalkTimeData
